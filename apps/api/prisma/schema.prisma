model CommunityEvent {
  id          String               @id @default(uuid()) @db.Uuid
  communityId String               @db.Uuid
  createdById String               @db.Uuid
  title       String
  description String
  format      CommunityEventFormat
  status      CommunityEventStatus @default(DRAFT)
