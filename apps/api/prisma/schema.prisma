  @@id([eventId, userId])
  @@index([userId, status, updatedAt(sort: Desc)])
}

model PortfolioItem {
  id             String              @id @default(uuid()) @db.Uuid
  ownerId        String              @db.Uuid
  communityId    String?             @db.Uuid
  publicationId  String?             @db.Uuid
  kind           PortfolioItemKind
  status         PortfolioItemStatus @default(DRAFT)
  title          String
  summary        String
  description    String
  coverUrl       String?
  lookingForTeam Boolean             @default(false)
  priceText      String?
  contactNote    String?
  links          Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  community      Community?          @relation(fields: [communityId], references: [id], onDelete: SetNull)
  publication    Publication?        @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  interactions   ConfirmedInteraction[]

  @@index([kind, status, updatedAt(sort: Desc)])
  @@index([ownerId, status, updatedAt(sort: Desc)])
  @@index([communityId, kind, status])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
